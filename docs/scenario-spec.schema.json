{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aylon23/GO-OUT/docs/scenario-spec.schema.json",
  "title": "Scenario Spec",
  "description": "A researched scenario, written outside the app (Claude chat or a scheduled task) and imported. Moves are in percent (-12.5 means -12.5%) over the horizon, each in the asset's own currency: the app measures stock performance only, so there are no currency factors. Factor ids match the app's factor model.",
  "type": "object",
  "required": ["spec_version", "kind", "id", "title", "created_at", "author", "question", "horizon", "summary", "branches", "confidence"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": 1 },
    "kind": { "const": "scenario" },
    "id": { "type": "string", "minLength": 8, "description": "A UUID. Importing the same id again replaces the earlier version." },
    "title": { "type": "string", "minLength": 1, "maxLength": 140 },
    "title_he": { "type": "string", "maxLength": 140 },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "author": { "enum": ["claude-chat", "scheduled-task", "manual", "ai-debate"] },
    "question": { "type": "string", "description": "The user's original text." },
    "horizon": { "enum": ["1w", "2w", "1m", "3m", "6m", "12m"] },
    "summary": { "type": "string", "minLength": 1, "description": "2-3 sentence bottom line." },
    "branches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/branch" }
    },
    "current_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "value", "as_of"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string" },
          "value": { "type": "string" },
          "as_of": { "$ref": "#/$defs/date" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "date": { "$ref": "#/$defs/date" }
        }
      }
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "what_would_change_my_view": { "type": "string" }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "factor_id": { "enum": ["market", "size", "value", "momentum", "quality", "rates", "oil", "gold"] },
    "sector_etf": { "enum": ["XLK", "XLF", "XLE", "XLV", "XLI", "XLY", "XLP", "XLU", "XLB", "XLRE", "XLC"] },
    "range": {
      "type": "object",
      "required": ["low", "mid", "high"],
      "properties": {
        "low": { "type": "number", "minimum": -95, "maximum": 500 },
        "mid": { "type": "number", "minimum": -95, "maximum": 500 },
        "high": { "type": "number", "minimum": -95, "maximum": 500 },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "required": ["name", "probability", "cause", "narrative", "factor_moves"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "cause": { "enum": ["supply", "demand", "policy", "geopolitical", "earnings", "other"] },
        "narrative": { "type": "string" },
        "transmission": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "direction"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "description": "\"trigger\" or a factor id" },
              "to": { "$ref": "#/$defs/factor_id" },
              "direction": { "enum": ["+", "-"] },
              "explanation": { "type": "string" }
            }
          }
        },
        "factor_moves": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/factor_id" },
          "additionalProperties": { "$ref": "#/$defs/range" }
        },
        "sector_overrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/sector_etf" },
          "additionalProperties": { "$ref": "#/$defs/range" }
        },
        "analogs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "start", "end"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "start": { "$ref": "#/$defs/date" },
              "end": { "$ref": "#/$defs/date" },
              "why_similar": { "type": "string" }
            }
          }
        },
        "signposts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["indicator", "condition", "value", "meaning"],
            "additionalProperties": false,
            "properties": {
              "indicator": { "type": "string" },
              "symbol": { "type": "string", "description": "Optional Yahoo Finance symbol the app can check, e.g. CL=F, ^VIX, ILS=X" },
              "condition": { "enum": [">", "<"] },
              "value": { "type": "number" },
              "meaning": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
